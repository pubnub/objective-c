workspace 'PubNub Tests'
install! 'cocoapods', :lock_pod_sources => false
use_frameworks!

abstract_target 'MockableTests' do
  pod 'PubNub', :path => '../'
  pod 'OCMock', '= 3.6'
  pod 'YAHTTPVCR'
 
  target '[macOS] Mocked Integration Tests' do
    platform :osx, '14.6'
  end

  target '[tvOS] Mocked Integration Tests' do
    platform :tvos, '17.6'
  end

  target '[iOS] Mocked Integration Tests' do
    platform :ios, '17.6'
  end

  target '[macOS] Unit Tests' do
    platform :osx, '14.6'
  end

  target '[tvOS] Unit Tests' do
    platform :tvos, '17.6'
  end

  target '[iOS] Unit Tests' do
    platform :ios, '17.6'
  end
end

target '[iOS] Integration Tests' do
  platform :ios, '17.6'
  pod 'PubNub', :path => '../'
end


abstract_target 'ContractTests' do
#  pod 'Cucumberish', :git => 'https://github.com/parfeon/Cucumberish.git', :branch => 'master', :inhibit_warnings => true
  pod 'Cucumberish'
  pod 'PubNub', :path => '../'

  target '[iOS] Contract Tests' do
    platform :ios, '17.6'
  end

  target '[iOS] Contract Tests Beta' do
    platform :ios, '17.6'
  end
end


# Make PubNub's internal headers accessible to tests,
# except the manually declared Swift compatibility interface.
pre_install do |installer|
  installer.pod_targets.each do |pod_target|
    next unless pod_target.pod_name == 'PubNub'

    pod_target.specs.each do |spec|
      private_headers = Array(spec.attributes_hash['private_header_files'])

      next if private_headers.empty?

      spec.attributes_hash['private_header_files'] =
        private_headers.select do |pattern|
          pattern == 'PubNub/Modules/Crypto/Cryptors/AES/PNCryptoKitWrapper.h'
        end
    end
  end
end

post_install do |installer_representation|
    installer_representation.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
            config.build_settings['CLANG_ENABLE_CODE_COVERAGE'] = target.name =~ /PubNub/ ? 'YES' : 'NO'
            config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.6'
            config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.6'
            config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '17.6'
        end
        if target.name =~ /OCMock/
          target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.6'
            config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.6'
            config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '17.6'
          end
        end
        if target.name =~ /YAHTTPVCR/
          target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.6'
            config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.6'
            config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '17.6'
          end
        end
    end
end
